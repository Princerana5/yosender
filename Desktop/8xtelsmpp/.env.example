# ── 8xtelSMPP environment ─────────────────────────────────────────────
NODE_ENV=development

# PostgreSQL (persistent source of truth)
DATABASE_URL=postgres://xtel:xtel_secret@postgres:5432/xtelsmpp
POSTGRES_USER=xtel
POSTGRES_PASSWORD=xtel_secret
POSTGRES_DB=xtelsmpp

# Redis (queues, rate limiting, connection state, stats)
REDIS_URL=redis://redis:6379

# API
API_PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# SMPP server (downstream clients bind here)
SMPP_PORT=2775
SMPP_HOST=0.0.0.0
SMPP_SYSTEM_ID_PREFIX=client_

# Public hostname given to clients
SMPP_PUBLIC_HOST=smpp.8xtelsmpp.com

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# Super-admin bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@8xtelsmpp.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
