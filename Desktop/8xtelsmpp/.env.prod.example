# ── 8xtelSMPP production environment ──────────────────────────────────────
# Copy to .env on the server and fill in EVERY value marked REQUIRED.
# Generate secrets with:  openssl rand -hex 32
# NEVER commit .env. NEVER reuse dev secrets.

NODE_ENV=production

# ── PostgreSQL (REQUIRED: strong password) ───────────────────────────────
POSTGRES_USER=xtel
POSTGRES_PASSWORD=REQUIRED-change-me-32plus-chars
POSTGRES_DB=xtelsmpp
# Per-service pool. 7 services × this must stay under ~80 (postgres max 100).
PG_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── API (REQUIRED: long random JWT secret) ───────────────────────────────
API_PORT=8080
JWT_SECRET=REQUIRED-openssl-rand-hex-32
JWT_EXPIRES_IN=12h

# ── SMPP server (downstream clients bind here) ───────────────────────────
SMPP_PORT=2775
SMPP_HOST=0.0.0.0

# ── Public hostnames (REQUIRED: your real domains) ───────────────────────
# Panel + portal UI (TLS via edge proxy):
PANEL_HOST=panel.example.com
# Given to SMPP clients as their bind host:
SMPP_PUBLIC_HOST=smpp.example.com

# ── Vendor secret (REQUIRED: encrypts upstream vendor passwords) ─────────
# 32-byte key material — any long random string works (sha256-hashed).
VENDOR_SECRET_KEY=REQUIRED-openssl-rand-hex-32

# ── Super-admin bootstrap (REQUIRED: change immediately after first login)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REQUIRED-long-random-password
